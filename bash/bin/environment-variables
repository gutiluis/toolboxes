#!/usr/bin/env bash

# filename: default-environment-variables.sh
# desc: print default shell environment variables

echo ${BASH_VERSION}
echo ${BASHPID}
echo ${GROUPS}
echo ${HOSTNAME}
echo ${OSTYPE}
echo ${PWD}
echo ${RANDOM}
echo "[INFO] User ID to the current user"
echo ${UID}
echo "[INFO] Full pathname to the shell"
echo ${SHELL}
