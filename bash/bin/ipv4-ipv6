#!/usr/bin/env bash
#-----
# networking script for unix =====>>> ITP/IP
#----
make_function() {
    printf -- "-------BASH NETWORKING MENU-------:\n"
    printf -- "1) ifconfig       - show IPv4 address\n"
    printf -- "2) networksetup   - show IPv4 and IPv6 config for Wi-Fi\n"
    printf -- "3) ipconfig       - show IPv4 address for the en0 interface\n"
    printf -- "4) scutil         - show network state with IPv4 and IPv6 addresses\n"
    printf -- "----------------------------------\n"

    read -r -p "Select an option: " choice

    case "$choice" in
        1)
            echo "========================================================="
            echo "[INFO] $(date '+%Y-%m-%d %H:%M:%S') - IPv4 network interface"
            ifconfig en0 | awk '/inet / {print "IP address:", $2, "| Netmask:", $4, "| Broadcast:", $6}'
            ;;
        2)
            echo "========================================================="
            echo "[INFO] $(date '+%Y-%m-%d %H:%M:%S') - Wi-Fi IPv4 and IPv6"
            networksetup -getinfo Wi-Fi
            ;;
        3)
            echo "========================================================="
            echo "[INFO] $(date '+%Y-%m-%d %H:%M:%S') - IPv4 address for the en0 interface"
            ipconfig getifaddr en0
            ;;
        4)
            echo "========================================================="
            echo "[INFO] $(date '+%Y-%m-%d %H:%M:%S') - network state"
            scutil --nwi
            ;;
        *)
            echo "[INFO] No output logged..."
            ;;
    esac
}

while true; do
    make_function
    echo
    read -r -p "Retry? (yes or no): " retry_choice
    retry_choice=$(echo "$retry_choice" | awk '{print tolower($0)}')

    if [[ "$retry_choice" == "no" || "$retry_choice" == "n" ]]; then
        echo "[INFO] End of program..."
        break
    fi;
done;

